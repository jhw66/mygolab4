syntax = "v1"

info (
	title:   "MyVideo API"
	desc:    "视频应用接口"
	author:  "jhw66"
	version: "1.0"
)

// ==================== 请求类型 ====================
type (
	LoginItem {
		Need2FA        bool   `json:"need2fa"`
		ChallengeToken string `json:"challengeToken,omitempty"`
		AccessToken  string `json:"accessToken,omitempty"`
		RefreshToken string `json:"refreshToken,omitempty"`
	}
	TotpEnrollStartItem {
		Issuer        string `json:"issuer"`
		AccountName   string `json:"accountName"`
		OTPAuthURL    string `json:"otpauthUrl"`
		QRCodeDataURL string `json:"qrCodeDataUrl"`
	}
	TotpEnrollConfirmItem {
		Enabled bool `json:"enabled"`
	}
	Disable2FAItem {
		Enabled bool `json:"enabled"`
	}
	TotpVerifyItem {
		AccessToken  string `json:"accessToken,omitempty"`
		RefreshToken string `json:"refreshToken,omitempty"`
	}
	RefreshTokenItem {
		AccessToken string `json:"accessToken,omitempty"`
	}
	UserItem {
		Id        string `json:"id"`
		Username  string `json:"username"`
		Nickname  string `json:"nickname"`
		CreatedAt int64  `json:"created_at"`
		Avatar    string `json:"avatar"`
	}
	VideoItem {
		Id            string `json:"id"`
		Title         string `json:"title"`
		Url           string `json:"url"`
		Info          string `json:"info"`
		Cover         string `json:"cover"`
		CommentCount  uint   `json:"comment_count"`
		FavoriteCount uint   `json:"favorite_count"`
		CreatedAt     int64  `json:"created_at"`
	}
	CommentItem {
		Id        string   `json:"id"`
		UserId    string   `json:"user_id"`
		VideoId   string   `json:"video_id"`
		CommentId string   `json:"comment_id,omitempty"`
		RootId    string   `json:"root_id,omitempty"`
		Content   string   `json:"content"`
		FavoriteCount uint `json:"favorite_count"`
		IsDeleted bool     `json:"is_deleted"`
		CreatedAt int64    `json:"created_at"`
		User      UserItem `json:"user"`
	}
	CommentListData {
		Total    int64         `json:"total"`
		Page     int           `json:"page"`
		PageSize int           `json:"page_size"`
		Comments []CommentItem `json:"comments"`
	}
	CommonRsp {
		Status int    `json:"status"`
		Msg    string `json:"msg,omitempty"`
		Error  string `json:"error,omitempty"`
	}
	UserRegisterReq {
		NickName        string `json:"nick_name"`
		UserName        string `json:"user_name"`
		Password        string `json:"password"`
		PasswordConfirm string `json:"password_confirm"`
	}
	UserRegisterResp {
		Status int       `json:"status"`
		Data   *UserItem `json:"data,omitempty"`
		Msg    string    `json:"msg,omitempty"`
		Error  string    `json:"error,omitempty"`
	}
	UserLoginReq {
		UserName string `json:"user_name"`
		Password string `json:"password"`
	}
	UserLoginResp {
		Status int       `json:"status"`
		Data   *LoginItem `json:"data,omitempty"`
		Msg    string     `json:"msg,omitempty"`
		Error  string     `json:"error,omitempty"`
	}
	TotpEnrollStartReq  {}
	TotpEnrollStartResp {
		Status int                 `json:"status"`
		Data   *TotpEnrollStartItem `json:"data,omitempty"`
		Msg    string               `json:"msg,omitempty"`
		Error  string               `json:"error,omitempty"`
	}
	TotpEnrollConfirmReq {
		Code string `json:"code"`
	}
	TotpEnrollConfirmResp {
		Status int                   `json:"status"`
		Data   *TotpEnrollConfirmItem `json:"data,omitempty"`
		Msg    string                 `json:"msg,omitempty"`
		Error  string                 `json:"error,omitempty"`
	}
	TotpVerifyReq {
		Code           string `json:"code"`
	}
	TotpVerifyResp {
		Status int             `json:"status"`
		Data   *TotpVerifyItem `json:"data,omitempty"`
		Msg    string          `json:"msg,omitempty"`
		Error  string          `json:"error,omitempty"`
	}
	Disable2FAReq {
		Password string `json:"password"`
		Code     string `json:"code"`
	}
	Disable2FAResp {
		Status int            `json:"status"`
		Data   *Disable2FAItem `json:"data,omitempty"`
		Msg    string          `json:"msg,omitempty"`
		Error  string          `json:"error,omitempty"`
	}
	RefreshTokenReq  {
		RefreshToken string `json:"refresh_token,optional"`
	}
	RefreshTokenResp {
		Status int               `json:"status"`
		Data   *RefreshTokenItem `json:"data,omitempty"`
		Msg    string            `json:"msg,omitempty"`
		Error  string            `json:"error,omitempty"`
	}
	UserRsp {
		Status int      `json:"status"`
		Data   *UserItem `json:"data,omitempty"`
		Msg    string    `json:"msg,omitempty"`
		Error  string    `json:"error,omitempty"`
	}
	UserListRsp {
		Status int        `json:"status"`
		Data   *[]UserItem `json:"data,omitempty"`
		Msg    string      `json:"msg,omitempty"`
		Error  string      `json:"error,omitempty"`
	}
	VideoRsp {
		Status int       `json:"status"`
		Data   *VideoItem `json:"data,omitempty"`
		Msg    string     `json:"msg,omitempty"`
		Error  string     `json:"error,omitempty"`
	}
	VideoListRsp {
		Status int         `json:"status"`
		Data   *[]VideoItem `json:"data,omitempty"`
		Msg    string       `json:"msg,omitempty"`
		Error  string       `json:"error,omitempty"`
	}
	CommentListRsp {
		Status int             `json:"status"`
		Data   *CommentListData `json:"data,omitempty"`
		Msg    string           `json:"msg,omitempty"`
		Error  string           `json:"error,omitempty"`
	}
	VideoSearchReq {
		KeyWord string `form:"key_word"`
	}
	VideoIdReq {
		Id string `path:"id"`
	}
	FavoriteReq {
		Vid       string `path:"vid"`
		CommentId string `form:"comment_id,optional"`
	}
	CommentAddReq {
		Vid       string `path:"vid"`
		CommentId string `form:"comment_id,optional"`
		Content   string `json:"content"`
	}
	CommentListReq {
		Vid      string `path:"vid"`
		CommentId string `form:"comment_id,optional"`
		Page     int    `form:"page,optional"`
		PageSize int    `form:"page_size,optional"`
	}
	DelCommentReq {
		Vid string `path:"vid"`
		Cid string `path:"cid"`
	}
	RelationReq {
		Uid string `path:"uid"`
	}
	ChatReq {
		RoomID string `path:"room_id"`
	}
	ChatRoomItem {
		ID         string `json:"id"`
		RoomName   string `json:"room_name"`
		Visibility string `json:"visibility"`
		OwnerID    string `json:"owner_id"`
		CreatedAt  int64  `json:"created_at"`
	}
	GetRoomResp {
		Status int             `json:"status"`
		Data   *[]ChatRoomItem `json:"data,omitempty"`
		Msg    string          `json:"msg,omitempty"`
		Error  string          `json:"error,omitempty"`
	}
	AddRoomReq {
		RoomName   string `json:"room_name"`
		Visibility string `json:"visibility"`
		Password   string `json:"password,optional"`
	}
	AddRoomResp {
		Status int           `json:"status"`
		Data   *ChatRoomItem `json:"data,omitempty"`
		Msg    string        `json:"msg,omitempty"`
		Error  string        `json:"error,omitempty"`
	}
	AddMemberReq {
		RoomID string `path:"room_id"`
		UserID string `json:"user_id"`
		Role   string `json:"role"`
	}
	AddMemberResp {
		Status int    `json:"status"`
		Msg    string `json:"msg,omitempty"`
		Error  string `json:"error,omitempty"`
	}
	JoinRoomReq {
		RoomID   string `path:"room_id"`
		Password string `json:"password,optional"`
	}
	JoinRoomResp {
		Status int    `json:"status"`
		Msg    string `json:"msg,omitempty"`
		Error  string `json:"error,omitempty"`
	}
	ChatMessageItem {
		ID        string `json:"id"`
		RoomID    string `json:"room_id"`
		UserID    string `json:"user_id"`
		Content   string `json:"content"`
		CreatedAt int64  `json:"created_at"`
	}
	ChatMessageListData {
		Total    int64              `json:"total"`
		Page     int                `json:"page"`
		PageSize int                `json:"page_size"`
		Messages *[]ChatMessageItem `json:"messages,omitempty"`
	}
	GetMessagesReq {
		RoomID   string `path:"room_id"`
		Page     int    `form:"page,optional"`
		PageSize int    `form:"page_size,optional"`
	}
	GetMessagesResp {
		Status int                  `json:"status"`
		Data   *ChatMessageListData `json:"data,omitempty"`
		Msg    string               `json:"msg,omitempty"`
		Error  string               `json:"error,omitempty"`
	}
)

// ==================== 公开路由 ====================
@server (
	prefix: /api/v1
	group:  common
)
service myvideo-api {
	@handler UserRegister
	post /user/register (UserRegisterReq) returns (UserRegisterResp)

	@handler UserLogin
	post /user/login (UserLoginReq) returns (UserLoginResp)

	@handler totpVerify
	post /totp/verify (TotpVerifyReq) returns (TotpVerifyResp)

	@handler RefreshToken
	post /refresh (RefreshTokenReq) returns (RefreshTokenResp)

	@handler VideoSearch
	get /videos/search (VideoSearchReq) returns (VideoListRsp)

	@handler RankVideos
	get /video/rank returns (VideoListRsp)

	@handler VideoDetail
	get /video/:id (VideoIdReq) returns (VideoRsp)

	@handler CommentList
	get /comment/:vid (CommentListReq) returns (CommentListRsp)
}

// ==================== 保护路由（JWT 认证） ====================
@server (
	prefix:     /api/v1/p/totp
	group:      totp
	middleware: AccessAuth
)
service myvideo-api {
	@handler totpEnrollStart
	post /enroll/start (TotpEnrollStartReq) returns (TotpEnrollStartResp)

	@handler totpEnrollConfirm
	post /enroll/confirm (TotpEnrollConfirmReq) returns (TotpEnrollConfirmResp)

	@handler totpDisable
	post /disable (Disable2FAReq) returns (Disable2FAResp)
}

@server (
	prefix:     /api/v1/p/user
	group:      user
	middleware: AccessAuth
)
service myvideo-api {
	@handler UserMe
	get /me returns (UserRsp)

	@handler UserLogout
	post /logout returns (CommonRsp)

	@handler UserAvatar
	post /avatar returns (UserRsp)
}

@server (
	prefix:     /api/v1/p/video
	group:      video
	middleware: AccessAuth
)
service myvideo-api {
	@handler UploadVideo
	post / returns (VideoRsp)

	@handler MyVideo
	get /me returns (VideoListRsp)

	@handler UpdateVideo
	put /:id (VideoIdReq) returns (VideoRsp)

	@handler DeleteVideo
	delete /:id (VideoIdReq) returns (CommonRsp)
}

@server (
	prefix:     /api/v1/p/favorite
	group:      favorite
	middleware: AccessAuth
)
service myvideo-api {
	@handler Favorite
	post /:vid (FavoriteReq) returns (CommonRsp)
}

@server (
	prefix:     /api/v1/p
	group:      favorite
	middleware: AccessAuth
)
service myvideo-api {
	@handler FavoriteList
	get /favoriteList/me returns (VideoListRsp)
}

@server (
	prefix:     /api/v1/p/comment
	group:      comment
	middleware: AccessAuth
)
service myvideo-api {
	@handler Comment
	post /:vid (CommentAddReq) returns (CommonRsp)

	@handler DelComment
	delete /:vid/:cid (DelCommentReq) returns (CommonRsp)
}

@server (
	prefix:     /api/v1/p/relation
	group:      relation
	middleware: AccessAuth
)
service myvideo-api {
	@handler RelationAction
	post /:uid (RelationReq) returns (CommonRsp)

	@handler FollowingList
	get /following returns (UserListRsp)

	@handler FollowerList
	get /follower returns (UserListRsp)

	@handler FriendList
	get /friend returns (UserListRsp)
}

@server (
	prefix:     /ws
	group:      chat
	middleware: AccessAuth
)
service myvideo-api {
	@handler Chat
	get /:room_id (ChatReq)
}

@server (
	prefix:     /rooms
	group:      chat
	middleware: AccessAuth
)
service myvideo-api {
	@handler GetRoom
	get / returns (GetRoomResp)

	@handler AddRoom
	post / (AddRoomReq) returns (AddRoomResp)

	@handler AddMember
	post /:room_id/addmember (AddMemberReq) returns (AddMemberResp)

	@handler JoinRoom
	post /:room_id/join (JoinRoomReq) returns (JoinRoomResp)

	@handler GetMessage
	get /:room_id/messages (GetMessagesReq) returns (GetMessagesResp)
}

